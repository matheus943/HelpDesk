<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel de Chamados - Help Desk</title>
    <link rel="stylesheet" href="/css/chamadosStyle.css">
</head>
<body>

    <!-- Menu Lateral -->
    <aside>
        <h2>Help Desk</h2>
        <nav>
            <a href="#" class="active">Painel Principal</a>
            <a href="#">Meus Chamados</a>
            <a href="#">Configurações</a>
        </nav>
    </aside>

    <!-- Área Principal -->
    <main>
        <header>
            <h1>Dashboard de Chamados</h1>
            <div class="user-info">Olá, <%= nomeUsuario %></div>
        </header>

        <div class="container">
            <div class="dashboard-grid">
                
                <!-- Coluna da Esquerda: Formulário de Abertura -->
                <div class="card">
                    <h3>Novo Chamado</h3>
                    <form id="form-chamado">
                        <div class="form-group">
                            <label for="titulo">Título do Problema</label>
                            <input type="text" id="titulo" placeholder="Ex: Erro ao conectar na VPN" required>
                        </div>
                        <div class="form-group">
                            <label for="prioridade">Prioridade</label>
                            <select id="prioridade">
                                <option value="baixa">Baixa</option>
                                <option value="media" selected>Média</option>
                                <option value="alta">Alta</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="descricao">Descrição Detalhada</label>
                            <textarea id="descricao" rows="4" placeholder="Explique o que está acontecendo..." required></textarea>
                        </div>
                        <button type="submit">Cadastrar Chamado</button>
                    </form>
                </div>

                <!-- Coluna da Direita: Lista de Chamados Recentes -->
                <div class="card">
                    <h3>Chamados Abertos</h3>
                    <div class="ticket-list" id="ticket-list">
                        <!-- Exemplo estático (depois você popula via JavaScript consumindo sua API Node.js) -->
                        <div class="ticket-item">
                            <div class="ticket-info">
                                <h4>Impressora do 2º andar sem toner</h4>
                                <p>Aberta por: Carlos Silva • 08/10/2026</p>
                            </div>
                            <div>
                                <span class="badge badge-media">Média</span>
                                <span class="badge badge-aberto">Aberto</span>
                            </div>
                        </div>

                        <div class="ticket-item">
                            <div class="ticket-info">
                                <h4>Falha de acesso ao sistema ERP</h4>
                                <p>Aberta por: Ana Souza • 08/10/2026</p>
                            </div>
                            <div>
                                <span class="badge badge-alta">Alta</span>
                                <span class="badge badge-aberto">Aberto</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <script>
        // Exemplo básico de como você poderá integrar com a sua API Node.js futuramente:
        document.getElementById('form-chamado').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const novoChamado = {
                titulo: document.getElementById('titulo').value,
                prioridade: document.getElementById('prioridade').value,
                descricao: document.getElementById('descricao').value
            };

            console.log("Dados prontos para enviar para o Node.js/MySQL:", novoChamado);
            alert("Simulação: Chamado enviado com sucesso! (Conecte com sua API Node.js via fetch em breve)");
            
            // Aqui entraria o fetch:
            // await fetch('http://localhost:3000/chamados', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(novoChamado) });
        });
    </script>
</body>
</html>