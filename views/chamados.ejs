<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel - Help Desk</title>
    <link rel="stylesheet" href="/css/chamadosStyle.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
</head>
<body class="dashboard-body">

    <header class="dashboard-header">
        <h2>Help Desk</h2>
        <!-- No Cabeçalho (substitua o link antigo do Sair por este botão) -->
        <div class="user-info">
            <% if (typeof fotoPerfil !== 'undefined' && fotoPerfil) { %>
                <img src="/uploads/<%= fotoPerfil %>" alt="Foto de Perfil" class="user-avatar-img">
            <% } else { %>
                <div class="user-avatar-default">
                    <%= nomeUsuario.charAt(0).toUpperCase() %>
                </div>
            <% } %>
            <span>Olá, <strong><%= nomeUsuario %></strong></span>
            
            <!-- Botão que abre o modal -->
            <button type="button" class="logout-link-btn" onclick="openLogoutModal()">||  Sair</button>
        </div>
    </header>

    <main class="dashboard-main">
        
        <!-- FORMULÁRIO DE NOVO CHAMADO -->
         <% if (tipoUsuario == "cliente") { %>
        <section class="dashboard-card">
            <h3>Abrir Novo Chamado</h3>
            
            <form action="/chamados/novo" method="POST">
                <div class="form-group">
                    <label>Título</label>
                    <input type="text" name="titulo" required placeholder="Resumo do problema">
                </div>

                <div class="form-row">
                    <div class="form-group" style="flex: 1;">
                        <label>Prioridade</label>
                        <select name="prioridade" class="form-select">
                            <option value="baixa">Baixa</option>
                            <option value="media" selected>Média</option>
                            <option value="alta">Alta</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label>Descrição</label>
                    <textarea name="descricao" required placeholder="Detalhe o que está acontecendo..."></textarea>
                </div>

                <button type="submit" class="btn-submit">Cadastrar Chamado</button>
            </form>
        </section>
        <% } %>
        <!-- LISTAGEM DOS CHAMADOS -->
        <section class="dashboard-card">
    <h3>Seus Chamados</h3>

    <% if (chamados.length === 0) { %>
        <p class="empty-message">Nenhum chamado aberto no momento.</p>
    <% } else { %>
        <!-- Grid adaptável para os chamados -->
        <div class="chamados-grid">
            <% chamados.forEach(chamado => { %>
                <div class="chamado-card-item">
                    <div class="chamado-header-item">
                        <h4 class="chamado-titulo-destaque"><%= chamado.titulo %></h4>
                        <span class="chamado-status <%= chamado.status %>">
                            <%= chamado.status %>
                        </span>
                    </div>
                    
                    <!-- Descrição com limite de altura e scroll interno -->
                    <div class="chamado-desc-container">
                        <p class="chamado-desc"><%= chamado.descricao %></p>
                    </div>

                    <div class="chamado-meta">
                        <small class="chamado-info">Prioridade: <strong><%= chamado.prioridade %></strong></small>
                        <% if (tipoUsuario == "tecnico") { %>
                            <small class="chamado-info">Criado por: <strong><%= chamado.nome_criador %></strong></small>
                        <% } %>
                        <small class="chamado-info">Aberto em: <strong><%= new Date(chamado.criado_em).toLocaleDateString('pt-BR') %></strong></small>
                    </div>
                    <div class="botao">
                        <% if (tipoUsuario == "tecnico") { %>
                            <div class="d-grid gap-9 md:d-flex md:justify-content-center">
                                <button class="btn-solid theme-primary md:me-2 w-50" type="button" onclick="openPriorityModal('<%= chamado.id %>')">Trocar Prioridade</button>
                                <button class="btn-solid theme-primary w-50" type="button">Concluido</button>
                            </div>
                        <% } %>
                        <% if (tipoUsuario == "cliente") { %>
                            <div class="d-grid gap-9 md:d-flex md:justify-content-center">
                                <button class="btn-solid theme-primary md:me-2 w-50" type="button" onclick="openEditClientModal('<%= chamado.id %>', '<%= chamado.titulo %>', '<%= chamado.prioridade %>', `<%= chamado.descricao %>`)">Editar</button>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</section>

    </main>
    <!-- MODAL DE CONFIRMAÇÃO DE LOGOUT -->
    <div id="logoutModal" class="modal-overlay">
        <div class="modal-card">
            <h3>Deseja realmente sair?</h3>
            <p>Você precisará fazer login novamente para acessar o seu painel de chamados.</p>
            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeLogoutModal()">Cancelar</button>
                <a href="/auth/logout" class="btn-confirm-logout">Sim, Sair</a>
            </div>
        </div>
    </div>
    <!-- MODAL DE ALTERAR PRIORIDADE -->
    <div id="priorityModal" class="modal-overlay">
        <div class="modal-card">
            <h3>Alterar Prioridade do Chamado</h3>
            <p>Selecione a nova prioridade para este atendimento:</p>
            
            <!-- O action será preenchido dinamicamente pelo JavaScript -->
            <form id="priorityForm" method="POST">
                <div class="priority-options" style="text-align: left; margin: 20px 0; display: flex; flex-direction: column; gap: 10px;">
                    <label style="color: #cbd5e1; cursor: pointer;">
                        <input type="radio" name="prioridade" value="baixa" required> Baixa
                    </label>
                    <label style="color: #cbd5e1; cursor: pointer;">
                        <input type="radio" name="prioridade" value="media" checked> Média
                    </label>
                    <label style="color: #cbd5e1; cursor: pointer;">
                        <input type="radio" name="prioridade" value="alta"> Alta
                    </label>
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn-cancel" onclick="closePriorityModal()">Cancelar</button>
                    <button type="submit" class="btn-submit" style="flex: 1;">Salvar Alteração</button>
                </div>
            </form>
        </div>
    </div>
    <!-- MODAL DE ALTERAÇÃO DO CLIENTE -->
<div id="editClientModal" class="modal-overlay">
    <div class="modal-card" style="max-width: 450px; text-align: left;">
        <h3 style="text-align: center; margin-bottom: 15px;">Editar Chamado</h3>
        
        <!-- O action será preenchido dinamicamente pelo JavaScript com o ID do chamado -->
        <form id="editClientForm" method="POST">
            <div class="form-group">
                <label>Título</label>
                <input type="text" id="editTitulo" name="titulo" required>
            </div>

            <div class="form-group">
                <label>Prioridade</label>
                <select name="prioridade" id="editPrioridade" class="form-select">
                    <option value="baixa">Baixa</option>
                    <option value="media">Média</option>
                    <option value="alta">Alta</option>
                </select>
            </div>

            <div class="form-group">
                <label>Descrição</label>
                <textarea name="descricao" id="editDescricao" required style="min-height: 100px;"></textarea>
            </div>

            <div class="modal-actions" style="margin-top: 20px;">
                <button type="button" class="btn-cancel" onclick="closeEditClientModal()">Cancelar</button>
                <button type="submit" class="btn-submit" style="flex: 1;">Salvar Alterações</button>
            </div>
        </form>
    </div>
</div>

    <!-- SCRIPT PARA CONTROLAR O MODAL -->
    <script>
        function openLogoutModal() {
            document.getElementById('logoutModal').classList.add('active');
        }

        function closeLogoutModal() {
            document.getElementById('logoutModal').classList.remove('active');
        }

        // Fecha o modal se o usuário clicar no fundo escuro/desfocado ao redor
        window.onclick = function(event) {
            const modal = document.getElementById('logoutModal');
            if (event.target === modal) {
                closeLogoutModal();
            }
        }

        function openPriorityModal(chamadoId) {
        const modal = document.getElementById('priorityModal');
        const form = document.getElementById('priorityForm');
        
        // Define dinamicamente para qual rota o formulário vai enviar o ID correto
        form.action = `/chamados/alteracao/${chamadoId}`;
        
        modal.classList.add('active');
    }

    function closePriorityModal() {
        document.getElementById('priorityModal').classList.remove('active');
    }

    // Fecha o modal se clicar fora dele
    window.onclick = function(event) {
        const priorityModal = document.getElementById('priorityModal');
        const logoutModal = document.getElementById('logoutModal');
        
        if (event.target === priorityModal) {
            closePriorityModal();
        }
        if (event.target === logoutModal) {
            closeLogoutModal();
        }
    }

    function openEditClientModal(id, titulo, prioridade, descricao) {
    const modal = document.getElementById('editClientModal');
    const form = document.getElementById('editClientForm');
    
    // Define a rota de envio para o ID correto do chamado
    form.action = `/chamados/alteracao/${id}`;
    
    // Preenche os inputs com os valores atuais do chamado
    document.getElementById('editTitulo').value = titulo;
    document.getElementById('editPrioridade').value = prioridade;
    document.getElementById('editDescricao').value = descricao;
    
    modal.classList.add('active');
}

function closeEditClientModal() {
    document.getElementById('editClientModal').classList.remove('active');
}

// Atualize a função de fechar ao clicar fora para incluir o novo modal
window.onclick = function(event) {
    const priorityModal = document.getElementById('priorityModal');
    const logoutModal = document.getElementById('logoutModal');
    const editClientModal = document.getElementById('editClientModal');
    
    if (event.target === priorityModal) closePriorityModal();
    if (event.target === logoutModal) closeLogoutModal();
    if (event.target === editClientModal) closeEditClientModal();
}
    </script>
</body>
</html>